---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = await getCollection('blog');
const tagMap = new Map<string, number>();

posts.forEach((post) => {
	post.data.tags?.forEach((tag) => {
		tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
	});
});

const tags = Array.from(tagMap.entries())
	.sort((a, b) => b[1] - a[1])
	.map(([tag, count]) => ({ tag, count }));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Tags" description="Browse all topics on the blog." />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-[640px] px-5 pb-16 pt-8">
			<h1 class="m-0 mb-8 flex items-center gap-2 text-[1.75rem] font-extrabold tracking-tight text-heading">
				<span class="h-7 w-1 rounded-sm bg-gradient-to-b from-accent to-accent-light"></span>
				Tags
			</h1>
			<div class="flex flex-wrap gap-2">
				{
					tags.map(({ tag, count }) => (
						<a
							href={`/tags/${tag}/`}
							class="group inline-flex items-center gap-1.5 rounded-full border border-transparent bg-surface-soft px-3.5 py-[0.4375rem] font-mono text-[0.78rem] text-body no-underline transition-all duration-300 ease-fluid hover:border-accent/30 hover:bg-accent/10 hover:text-accent"
						>
							<span>#{tag}</span>
							<span class="rounded-full bg-accent/10 px-1.5 py-0.5 text-[0.65rem] font-medium tabular-nums text-accent transition-colors duration-300 group-hover:bg-accent group-hover:text-surface">
								{count}
							</span>
						</a>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
