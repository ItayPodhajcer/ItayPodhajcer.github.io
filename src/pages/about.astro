---
import { getCollection, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { AUTHOR_AVATAR } from '../consts';

const aboutEntries = await getCollection('about');
const aboutContent = aboutEntries[0];
const { Content } = aboutContent ? await render(aboutContent) : { Content: null };
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="About" description="Learn more about Itay Podhajcer." />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-[640px] px-5 pb-16 pt-10">
			{
				aboutContent && (
					<div>
						<div class="mx-auto mb-6 w-[120px] rounded-full bg-gradient-to-br from-accent to-violet-500 p-[3px] shadow-[0_8px_30px_rgba(249,115,22,0.25)]">
							<img
								class="block h-[114px] w-[114px] rounded-full object-cover"
								src={AUTHOR_AVATAR}
								alt={aboutContent.data.name}
							/>
						</div>
						<h1 class="mb-1 text-center text-[1.75rem] font-bold tracking-tight text-heading">
							{aboutContent.data.name}
						</h1>
						<p class="mb-8 text-center text-base font-medium text-accent">
							{aboutContent.data.title}
						</p>
					<article class="about-content text-body">
						{Content && <Content />}
					</article>
					</div>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-content {
		font-family: var(--font-serif);
		font-size: 1.0625rem;
		line-height: 1.78;
	}
	.about-content p {
		margin: 0 0 1rem;
	}
	.about-content h2 {
		margin: 2rem 0 1rem;
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--text-primary);
	}
	.about-content a {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.about-content a:hover {
		color: var(--accent-hover);
	}
	.about-content strong {
		color: var(--text-primary);
		font-weight: 600;
	}
	.about-content ul {
		margin: 0 0 1rem;
		padding-left: 1.5rem;
	}
	.about-content li {
		margin-bottom: 0.375rem;
	}
</style>
