---
import { SITE_TITLE, AUTHOR_AVATAR } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SearchModal from './SearchModal.astro';
---

<header
	class="sticky top-0 z-[100] w-full border-b border-line/70 bg-surface/75 backdrop-blur-xl backdrop-saturate-150"
>
	<nav class="mx-auto flex h-16 max-w-[1200px] items-center justify-between px-4">
		<div class="shrink-0">
			<a href="/" class="group flex items-center gap-2.5 no-underline hover:text-heading">
				<img
					src={AUTHOR_AVATAR}
					alt={SITE_TITLE}
					width="32"
					height="32"
					class="h-8 w-8 rounded-full border border-line transition-shadow duration-300 group-hover:shadow-[0_0_0_3px_color-mix(in_oklab,var(--accent)_30%,transparent)]"
				/>
				<h2 class="m-0 text-lg font-bold tracking-tight text-heading">{SITE_TITLE}</h2>
			</a>
		</div>

		<div class="flex gap-6 sm:gap-8">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/tags">Tags</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>

		<div class="relative flex items-center gap-2">
			<SearchModal />
			<button
				id="theme-toggle"
				class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg border-none bg-transparent text-muted transition-colors hover:bg-surface-soft hover:text-accent"
				title="Toggle theme"
				aria-label="Toggle theme"
			>
				<svg id="theme-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="5"/>
					<line x1="12" y1="1" x2="12" y2="3"/>
					<line x1="12" y1="21" x2="12" y2="23"/>
					<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
					<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
					<line x1="1" y1="12" x2="3" y2="12"/>
					<line x1="21" y1="12" x2="23" y2="12"/>
					<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
					<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
				</svg>
			</button>
			<div
				id="theme-menu"
				class="theme-menu absolute right-0 top-[calc(100%+8px)] z-[200] flex flex-col gap-0.5 rounded-xl border border-line bg-surface p-1 shadow-[0_4px_20px_rgba(0,0,0,0.15)]"
			>
				<div class="theme-option flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg text-body transition-colors hover:bg-surface-soft hover:text-heading" data-theme="light" title="Light">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="5"/>
						<line x1="12" y1="1" x2="12" y2="3"/>
						<line x1="12" y1="21" x2="12" y2="23"/>
						<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
						<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
						<line x1="1" y1="12" x2="3" y2="12"/>
						<line x1="21" y1="12" x2="23" y2="12"/>
						<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
						<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
					</svg>
				</div>
				<div class="theme-option flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg text-body transition-colors hover:bg-surface-soft hover:text-heading" data-theme="dark" title="Dark">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
					</svg>
				</div>
				<div class="theme-option flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg text-body transition-colors hover:bg-surface-soft hover:text-heading" data-theme="auto" title="System">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="2" y="3" width="20" height="14" rx="2" />
						<line x1="8" y1="21" x2="16" y2="21" />
						<line x1="12" y1="17" x2="12" y2="21" />
					</svg>
				</div>
			</div>
		</div>
	</nav>
</header>

<script>
	const themeToggle = document.getElementById('theme-toggle');
	const themeIcon = document.getElementById('theme-icon');
	const themeMenu = document.getElementById('theme-menu');

	const STORAGE_KEY = 'astro-theme';
	const DARK_ICON = `<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>`;
	const LIGHT_ICON = `<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>`;

	function getSystemTheme() {
		// Follow the OS, defaulting to dark when the OS expresses no preference.
		return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
	}

	function getPreferredTheme() {
		if (typeof localStorage !== 'undefined') {
			const stored = localStorage.getItem(STORAGE_KEY);
			if (stored) return stored;
		}
		return 'auto';
	}

	function applyTheme() {
		const storedTheme = getPreferredTheme();
		let activeTheme;

		if (storedTheme === 'auto') {
			activeTheme = getSystemTheme();
			themeIcon.innerHTML = activeTheme === 'dark' ? DARK_ICON : LIGHT_ICON;
		} else if (storedTheme === 'dark') {
			activeTheme = 'dark';
			themeIcon.innerHTML = DARK_ICON;
		} else {
			activeTheme = 'light';
			themeIcon.innerHTML = LIGHT_ICON;
		}

		const html = document.documentElement;
		if (activeTheme === 'dark') {
			html.classList.add('dark');
		} else {
			html.classList.remove('dark');
		}

		document.dispatchEvent(new CustomEvent('ecThemeChange'));
	}

	function setTheme(theme) {
		if (typeof localStorage !== 'undefined') {
			localStorage.setItem(STORAGE_KEY, theme);
		}
		applyTheme();
		hideThemeMenu();

		const event = new Event('themeChange');
		document.dispatchEvent(event);
	}

	function toggleThemeMenu() {
		themeMenu.classList.toggle('show');
	}

	function hideThemeMenu() {
		themeMenu.classList.remove('show');
	}

	function selectTheme(event) {
		const target = event.target.closest('.theme-option');
		if (target) {
			const theme = target.dataset.theme;
			setTheme(theme);
		}
	}

	applyTheme();

	themeToggle?.addEventListener('click', toggleThemeMenu);
	themeMenu?.addEventListener('click', selectTheme);

	document.addEventListener('click', (event) => {
		if (!themeToggle?.contains(event.target) && !themeMenu?.contains(event.target)) {
			hideThemeMenu();
		}
	});

	// Re-apply when the OS theme changes, but only while in "auto" mode.
	window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
		if (getPreferredTheme() === 'auto') applyTheme();
	});
</script>

<style>
	/* JS-driven dropdown: utilities handle layout; these handle the open/close transition. */
	.theme-menu {
		opacity: 0;
		visibility: hidden;
		transform: translateY(-8px);
		transition: all 0.2s ease;
	}

	.theme-menu.show {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}
</style>
